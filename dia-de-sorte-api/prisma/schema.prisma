generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum CampaignStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum TicketStatus {
  AVAILABLE
  ASSIGNED
  VOID
}

enum DrawStatus {
  PENDING
  RECORDED
  REVIEWED
}

model Organization {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime   @default(now())
  campaigns Campaign[]
  participants Participant[]
}

model Campaign {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  organization   Organization   @relation(fields: [organizationId], references: [id])
  name           String
  status         CampaignStatus @default(DRAFT)
  ticketPriceCents Int
  rulesVersion   String         @default("v1")
  prizeCents     Int?
  legacySample   Boolean @default(false)
  closesAt       DateTime?
  createdAt      DateTime       @default(now())
  tickets        Ticket[]
  draws          Draw[]
  orders     Order[]
  drawChecks     DrawCheck[]
  participantSessions ParticipantSession[]
  @@index([organizationId, status])
}

model Ticket {
  id         String       @id @default(uuid()) @db.Uuid
  campaignId String       @db.Uuid
  campaign   Campaign     @relation(fields: [campaignId], references: [id])
  serial     String
  status     TicketStatus @default(AVAILABLE)
  orderId String?     @db.Uuid
  order  Order?   @relation(fields: [orderId], references: [id])
  numbers    TicketNumber[]
  matches    TicketMatch[]
  createdAt  DateTime     @default(now())
  assignedAt DateTime?
  @@unique([campaignId, serial])
  @@unique([id, campaignId])
  @@index([campaignId, status])
}

model TicketNumber {
  id       String @id @default(uuid()) @db.Uuid
  ticketId String @db.Uuid
  campaignId String @db.Uuid
  ticket   Ticket @relation(fields: [ticketId, campaignId], references: [id, campaignId], onDelete: Cascade)
  position Int
  value    String @db.Char(4)
  @@unique([ticketId, position])
  @@unique([campaignId, value])
  @@unique([ticketId, value])
  @@index([value])
}

// Immutable administrative observation; this does not authorize a prize.
model DrawCheck {
  id String @id @default(uuid()) @db.Uuid
  campaignId String @db.Uuid
  campaign Campaign @relation(fields: [campaignId], references: [id])
  reference String
  number String @db.VarChar(4)
  actor String
  snapshot Json
  createdAt DateTime @default(now())
  @@unique([campaignId, reference])
  @@index([campaignId, createdAt])
}

model Order {
  id            String   @id @default(uuid()) @db.Uuid
  campaignId    String   @db.Uuid
  campaign      Campaign @relation(fields: [campaignId], references: [id])
  legacySample  Boolean @default(false)
  quantity      Int
  totalCents    Int
  createdAt     DateTime @default(now())
  tickets       Ticket[]
  participantId String? @db.Uuid
  participant Participant? @relation(fields: [participantId], references: [id])
  idempotencyKey String? @db.Uuid
  @@unique([participantId, idempotencyKey])
}

// A phone supplied at registration does not prove ownership.
model Participant {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id])
  name String @db.VarChar(120)
  phone String @db.VarChar(11)
  createdAt DateTime @default(now())
  sessions ParticipantSession[]
  orders Order[]
  welcomeMessages WhatsappWelcome[]
  @@index([organizationId])
}

// One welcome per organization/phone, without using the phone as authentication.
model WhatsappWelcome {
  id String @id @default(uuid()) @db.Uuid
  participantId String @db.Uuid
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  organizationId String @db.Uuid
  phone String @db.VarChar(11)
  name String @db.VarChar(120)
  consentVersion String @default("welcome-v1")
  consentedAt DateTime @default(now())
  status String @default("PENDING")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  lockedAt DateTime?
  sentAt DateTime?
  providerMessageId String?
  lastError String?
  @@unique([organizationId, phone])
  @@index([status, nextAttemptAt])
}

model ParticipantSession {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique @db.Char(64)
  participantId String @db.Uuid
  participant Participant @relation(fields: [participantId], references: [id])
  campaignId String? @db.Uuid
  campaign Campaign? @relation(fields: [campaignId], references: [id])
  selectedIds String[] @db.Uuid
  selectionKey String @default(uuid()) @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}

model Draw {
  id         String      @id @default(uuid()) @db.Uuid
  campaignId String      @db.Uuid
  campaign   Campaign    @relation(fields: [campaignId], references: [id])
  reference  String
  sourceUrl  String?
  status     DrawStatus  @default(PENDING)
  createdAt  DateTime    @default(now())
  results    DrawResult[]
  matches    TicketMatch[]
  @@unique([campaignId, reference])
}

model DrawResult {
  id       String @id @default(uuid()) @db.Uuid
  drawId   String @db.Uuid
  draw     Draw   @relation(fields: [drawId], references: [id], onDelete: Cascade)
  position Int
  number   String @db.Char(4)
  @@unique([drawId, position])
}

model TicketMatch {
  id       String @id @default(uuid()) @db.Uuid
  drawId   String @db.Uuid
  draw     Draw   @relation(fields: [drawId], references: [id])
  ticketId String @db.Uuid
  ticket   Ticket @relation(fields: [ticketId], references: [id])
  number   String @db.Char(4)
  verified Boolean @default(false)
  @@unique([drawId, ticketId, number])
  @@index([drawId])
}
