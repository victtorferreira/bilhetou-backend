DATABASE_URL="postgresql://sorteio:local_only_change_me@localhost:5432/dia_de_sorte?schema=public"
PORT=3000
# Zettpay checkout: OAuth secrets and webhook signing_secret stay server-side.
ZETTPAY_ENABLED=false
ZETTPAY_CLIENT_ID=
ZETTPAY_CLIENT_SECRET=
ZETTPAY_WEBHOOK_SIGNING_SECRET=
# Exact documented CASH-IN paid status, not cash-out/pre-approval status.
ZETTPAY_PAID_STATUS=approved
FRONTEND_ORIGIN=http://localhost:5173
# Server-only administrator credential, at least 32 random characters.
ADMIN_ACCESS_KEY=
ADMIN_ORGANIZATION_ID=
ADMIN_ACTOR=
# Organization used by the public site.
PUBLIC_ORGANIZATION_ID=
# Optional: select an open campaign belonging to that organization.
PUBLIC_CAMPAIGN_ID=
# Used only by the explicit organization:create command on a new installation.
ORGANIZATION_NAME=

# WhatsApp welcome worker. Secrets stay on the backend; never use VITE_ prefixes.
# waha (default, controlled by WAHA_ENABLED) or evolution (controlled by WHATSAPP_ENABLED).
WHATSAPP_PROVIDER=waha
WHATSAPP_ENABLED=false
EVOLUTION_BASE_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=bilhetou
WAHA_ENABLED=false
WAHA_BASE_URL=http://127.0.0.1:3001
WAHA_API_KEY=
WAHA_SESSION=default
# Only needed when using docker-compose.waha.yml locally.
WAHA_DASHBOARD_PASSWORD=
WAHA_SWAGGER_PASSWORD=
