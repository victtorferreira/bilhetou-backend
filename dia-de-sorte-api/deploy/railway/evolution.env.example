# Service: evolution. Railway variable references require these exact service names.
# Docker image: evoapicloud/evolution-api:v2.3.7
SERVER_TYPE=http
SERVER_PORT=8080
PORT=8080
# Replace after generating a public domain in Railway (port 8080).
SERVER_URL=https://SEU-DOMINIO.up.railway.app
AUTHENTICATION_API_KEY=SUBSTITUA_POR_UMA_NOVA_CHAVE_ALEATORIA
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=${{evolution-db.DATABASE_URL}}
DATABASE_CONNECTION_CLIENT_NAME=bilhetou_evolution
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=false
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_HISTORIC=false
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=${{evolution-redis.REDIS_URL}}
CACHE_REDIS_PREFIX_KEY=bilhetou_evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false
DEL_INSTANCE=false
LOG_LEVEL=ERROR,WARN,INFO,LOG
LOG_BAILEYS=error
WEBHOOK_GLOBAL_ENABLED=false
RABBITMQ_ENABLED=false
SQS_ENABLED=false
WEBSOCKET_ENABLED=false
KAFKA_ENABLED=false
CHATWOOT_ENABLED=false
TYPEBOT_ENABLED=false
OPENAI_ENABLED=false
DIFY_ENABLED=false
S3_ENABLED=false
